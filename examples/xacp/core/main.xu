@main

#xacp
#os
#strconv

fn hello_args(extra string) string {
    << "id: !i 1\nop: xacp.hello\nargs:\n  ver: !ver 1.0.0\n  nonce: core-nonce\n" + extra
}

fn check_core() int {
    limits := xacp.default_limits()
    // These independent session checks deliberately reuse the same hello nonce.
    $nonces := xacp.new_nonce_registry(1, false)
    hello := xacp.parse_frame(hello_args("")) or >>
    status := xacp.parse_frame("id: !i 2\nop: proc.status\nargs: {}\n") or >>
    $session := xacp.open_session()
    opened := xacp.dispatch($&session, &hello, &limits, $&nonces)
    if !opened.ok || session.state != xacp.STATE_OPEN { << 1 }
    if session.permissions != xacp.PERM_INFO || session.nonce != "core-nonce" { << 2 }
    unimplemented := xacp.dispatch($&session, &status, &limits, $&nonces)
    if unimplemented.ok || unimplemented.err_code != "not_implemented" { << 3 }
    if session.state != xacp.STATE_OPEN || session.active_id != 0 { << 4 }
    if xacp.set_permissions($&session, xacp.PERM_ALL) { << 5 }
    xacp.close_session($&session)
    if session.nonce != "" || session.permissions != xacp.PERM_NONE { << 6 }
    closed := xacp.dispatch($&session, &status, &limits, $&nonces)
    if closed.ok || closed.err_code != "session_closed" { << 7 }

    // Host pre-grants cannot bypass the mandatory first hello.
    $fresh := xacp.open_session()
    if !xacp.set_permissions($&fresh, xacp.PERM_ALL) { << 8 }
    premature := xacp.dispatch($&fresh, &status, &limits, $&nonces)
    if premature.ok || premature.err_code != "hello_required" || fresh.state != xacp.STATE_CLOSED { << 9 }

    // Request/allowed intersection for every known bit combination.
    $allowed := xacp.PERM_ALL ^ xacp.PERM_UI_RAW
    if os.getenv("XU_XACP_ALLOW_RAW") == "1" { allowed = xacp.PERM_ALL }
    for requested in 0:32 {
        doc := xacp.parse_frame(hello_args("  token: core-token\n  permissions: !i " + str(requested) + "\n")) or >>
        $info := xacp.open_session()
        result := xacp.dispatch($&info, &doc, &limits, $&nonces)
        if !result.ok || info.permissions != (requested & xacp.PERM_INFO) { << 10 }
        $authenticated := xacp.open_session()
        granted := xacp.dispatch_with_token($&authenticated, &doc, &limits, "core-token", $&nonces)
        if !granted.ok || authenticated.permissions != (requested & allowed) { << 11 }
    }
    token_hello := xacp.parse_frame(hello_args("  token: core-token\n")) or >>
    $development := xacp.open_session()
    granted_all := xacp.dispatch_with_token($&development, &token_hello, &limits, "core-token", $&nonces)
    if !granted_all.ok || development.permissions != allowed { << 12 }
    $bad_token := xacp.open_session()
    rejected := xacp.dispatch_with_token($&bad_token, &token_hello, &limits, "different-token", $&nonces)
    if rejected.ok || rejected.err_code != "auth_failed" || bad_token.state != xacp.STATE_CLOSED { << 13 }
    if bad_token.nonce != "" || bad_token.permissions != xacp.PERM_NONE { << 14 }
    $missing_token := xacp.open_session()
    missing := xacp.dispatch_with_token($&missing_token, &hello, &limits, "core-token", $&nonces)
    if missing.ok || missing.err_code != "auth_failed" || missing_token.state != xacp.STATE_CLOSED { << 15 }
    invalid := xacp.parse_frame(hello_args("  permissions: !i 32\n")) or >>
    $malformed := xacp.open_session()
    schema := xacp.dispatch($&malformed, &invalid, &limits, $&nonces)
    if schema.ok || schema.err_code != "schema_error" || malformed.state != xacp.STATE_CLOSED { << 16 }

    // Lifecycle errors keep OPEN, preserve the active request, and allow recovery.
    request := xacp.validate_request(&status, &limits) or >>
    started := xacp.begin_request($&development, &request)
    if !started.ok { << 17 }
    busy := xacp.begin_request($&development, &request)
    if busy.ok || busy.err_code != "request_in_flight" { << 18 }
    stale := xacp.finish_request($&development, 3)
    if stale.ok || stale.err_code != "stale_request" || development.active_id != 2 { << 19 }
    finished := xacp.finish_request($&development, 2)
    if !finished.ok || development.state != xacp.STATE_OPEN { << 20 }
    repeated := xacp.begin_request($&development, &request)
    if repeated.ok || repeated.err_code != "invalid_request_id" || development.state != xacp.STATE_OPEN { << 21 }
    // Reserving hello alone is insufficient to enter OPEN.
    $unfinished := xacp.open_session()
    hello_request := xacp.validate_request(&hello, &limits) or >>
    reserved := xacp.begin_request($&unfinished, &hello_request)
    if !reserved.ok { << 22 }
    unnegotiated := xacp.finish_request($&unfinished, 1)
    if unnegotiated.ok || unfinished.state != xacp.STATE_CLOSED { << 23 }
    if limits.request_timeout_ms != 5000 { << 24 }
    expected_text := os.getenv("XACP_EXPECT_TIMEOUT_MS")
    if expected_text.len > 0 {
        expected := strconv.parse(&expected_text,10) or >>
        if xacp.request_timeout_from_env() != expected { << 25 }
    }
    // Timeout cancellation invalidates late finishes, even during a new request.
    canceled := xacp.Request{id: 3,op: "proc.status",args: 0}
    if !xacp.begin_request($&development,&canceled).ok { << 26 }
    xacp.cancel_request($&development)
    if development.active_id != 0 || development.active_generation != 0 { << 27 }
    late := xacp.finish_request($&development,3)
    if late.ok || late.err_code != "stale_request" { << 28 }
    next := xacp.Request{id: 4,op: "proc.status",args: 0}
    if !xacp.begin_request($&development,&next).ok { << 29 }
    stale_again := xacp.finish_request($&development,3)
    if stale_again.ok || development.active_id != 4 { << 30 }
    next_finished := xacp.finish_request($&development,4)
    if !next_finished.ok || development.state != xacp.STATE_OPEN { << 31 }
    println("XACP core: PASS")
    << 0
}

fn main() int {
    << check_core() or (err) {
        eprintln(err.msg())
        << 100
    }
}
